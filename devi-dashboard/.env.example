# Copier ce fichier en .env.local, puis renseigner les valeurs.
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<cle publishable / anon>

# Optionnel : connexion SQL pour `npm run db:sql` et `npm run db:init`.
# Par défaut le script lit le mot de passe dans supabase_passwoed.txt et
# détecte seul la région du pooler. À renseigner seulement si besoin.
# SUPABASE_POOLER_HOST=aws-1-eu-west-1.pooler.supabase.com
# SUPABASE_DB_PASSWORD=
# SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<mot-de-passe>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
