# Copier en .env et remplir. Ne jamais committer le .env.

# Connexion Postgres de Supabase (Project Settings > Database > Connection string, mode "Session").
# Le backend écrit dans les tables : il utilise la connexion serveur, jamais la clé publique.
DATABASE_URL=postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

# simulation : rien ne part chez Meta, les messages sont marqués « envoyés » et simulés.
# live       : envoi réel par l'API WhatsApp Cloud (les 4 variables WHATSAPP_* sont alors obligatoires).
WHATSAPP_MODE=simulation
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# Pour la démo : seuls ces numéros reçoivent des messages (chiffres avec indicatif, séparés par des virgules).
# Vide = tous les numéros. Les 300 enfants du seed ont de faux numéros : remplir cette liste en démo.
# Appliquée seulement en mode live : en simulation, tous les messages s'affichent dans le téléphone simulé.
DESTINATAIRES_AUTORISES=22890000000

# Jeton exigé sur les routes /admin (en-tête Authorization: Bearer <jeton>).
ADMIN_TOKEN=changer-moi

# Création des comptes par le pilotage (pages Structures et Comptes).
# Supabase > Project Settings > API Keys : clé secrète (sb_secret_...) ou ancienne clé service_role.
# Uniquement sur le serveur du backend (Render), jamais dans l'application ni dans git.
SUPABASE_URL=https://wcbzjukgelmztvluxrsn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Boucles automatiques (secondes). 0 = désactivé.
ENVOI_INTERVALLE_S=30
REGLES_INTERVALLE_S=0
