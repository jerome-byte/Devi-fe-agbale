# Copier en .env.local. Sans les deux variables Supabase, l'application reste en mode local
# (données fictives dans le navigateur).

# Supabase : Project Settings > API. Clé « anon » publique, lecture seule.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Backend FastAPI (Render en ligne, http://localhost:8000 en local).
# Variables serveur : jamais envoyées au navigateur.
BACKEND_URL=http://localhost:8000
BACKEND_TOKEN=
