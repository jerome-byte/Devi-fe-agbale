# Copier ce fichier en .env.local (dans scripts/), puis renseigner les valeurs.
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Connexion SQL pour `npm run db:sql`, `npm run db:init` et `npm run gerson:check`.
# Le mot de passe peut aussi être mis dans supabase_passwoed.txt (ignoré par git).
SUPABASE_POOLER_HOST=aws-1-eu-central-2.pooler.supabase.com
# SUPABASE_DB_PASSWORD=
# SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<mot-de-passe>@aws-1-eu-central-2.pooler.supabase.com:5432/postgres
